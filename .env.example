# ─────────────────────────────────────────────────────────────
# 카카오 (필수) — docs/01-kakao-setup.md
# ─────────────────────────────────────────────────────────────
# 앱 설정 > 플랫폼 키 > REST API 키
KAKAO_REST_API_KEY=
# 같은 화면의 Client Secret. 2025년 이후 생성된 키는 기본 활성화라 사실상 필수.
KAKAO_CLIENT_SECRET=
# init 으로 발급받은 리프레시 토큰. 로컬에서는 data/kakao_token.json 이
# 대신 쓰이므로 비워 둬도 되고, CI 에서는 이 값이 필요합니다.
KAKAO_REFRESH_TOKEN=
# 인가코드 발급에 쓴 redirect_uri 와 반드시 같아야 합니다.
KAKAO_REDIRECT_URI=http://localhost:3000/oauth

# ─────────────────────────────────────────────────────────────
# 온통청년 OpenAPI (선택) — docs/02-youth-api-key.md
# 없으면 전국 정책 수집만 건너뛰고 나머지는 그대로 동작합니다.
# ─────────────────────────────────────────────────────────────
YOUTH_API_KEY=

# ─────────────────────────────────────────────────────────────
# 내 조건 (선택) — 비우면 config.json 기본값을 씁니다
# ─────────────────────────────────────────────────────────────
# 시/도. 서울이 아니면 서울 전용 소스 3종은 자동으로 꺼집니다.
YOUTH_SIDO=서울특별시
YOUTH_SIDO_CODE=11
# 시/군/구. 자치구 정책 필터에 쓰입니다.
YOUTH_SIGUNGU=동작구
YOUTH_SIGUNGU_CODE=11590
YOUTH_AGE_MIN=25
YOUTH_AGE_MAX=35
# config.json 의 관심분야 중 남길 것만 콤마로. 비우면 전부.
# 기본 제공: 주거 / 금융·자산 / 일자리 / 교육·문화 / 복지·건강
YOUTH_INTERESTS=
# 온통청년 대상 조건. 정책이 특정 대상으로 한정된 경우 내 라벨과 겹쳐야 통과합니다.
# 비움 → config.json 값(특화분야만 '제한없음' 정책으로 제한, 나머지는 보지 않음)
# *    → 그 차원 필터 끔 / none → 제한없음 정책만 / 그 외 → 콤마로 내 라벨
# 특화분야: 중소기업 여성 기초생활수급자 한부모가정 장애인 농업인 군인 지역인재 기타
YOUTH_SPECIALIZATION=
# 취업상태: 재직자 자영업자 미취업자 프리랜서 일용근로자 (예비)창업자 단기근로자 영농종사자 기타
YOUTH_JOB=
# 학력: 고졸 미만 / 고교 재학 / 고졸 예정 / 고교 졸업 / 대학 재학 / 대졸 예정 / 대학 졸업 / 석·박사 / 기타
YOUTH_EDUCATION=
# 전공: 인문계열 사회계열 상경계열 이학계열 공학계열 예체능계열 농산업계열 기타
YOUTH_MAJOR=
# 결혼: 기혼 / 미혼
YOUTH_MARRIAGE=
# 지자체 게시판 선택. 현재 구현된 값: dongjak
# 다른 지역이면 none 으로 두거나 scripts/fetch.py 의 BOARDS 에 직접 추가하세요.
YOUTH_LOCAL_BOARD=dongjak
# 며칠 이내 공고까지 볼지 / 한 번에 보낼 최대 건수
YOUTH_LOOKBACK_DAYS=14
YOUTH_MAX_ITEMS=12
